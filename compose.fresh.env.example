# Localhost-only HTTP profile for compose.fresh.yaml.
# Copy this file to .env.fresh, choose a database password, and chmod 600 .env.fresh.
# Do not commit .env.fresh. Do not reuse compose.prod.yaml or its env file.
# This stack creates liveboard-studio-fresh_db and liveboard-studio-fresh_media.
# It does not attach to an existing database or media volume.

WEB_PORT=8080

# Exact browser origin. Use 127.0.0.1, not localhost.
# If 8080 is already in use, pick another free port and change both values.
CLIENT_URL=http://127.0.0.1:8080

# false is valid only while web is bound to 127.0.0.1 and the browser uses HTTP.
# For a future HTTPS deployment, set COOKIE_SECURE=true and set CLIENT_URL to the
# exact https origin. Do not commit that origin. Do not hardcode a public domain.
# Publishing beyond 127.0.0.1 is a separate change. This file does not do it.
COOKIE_SECURE=false

POSTGRES_DB=liveboard_studio
POSTGRES_USER=liveboard
POSTGRES_PASSWORD=replace_with_a_new_database_password

# The compose file sets these inside the API container:
# DB_HOST=db
# DB_PORT=5432
# MEDIA_DIR=/app/storage/media
# PORT=4002
# NODE_ENV=production
# VITE_API_BASE_URL is empty at image build, so the browser uses same-origin /api and /socket.io.

# Do not put ADMIN_USERNAME or ADMIN_PASSWORD in this file.
# Create the account with the one-shot bootstrap command, then unset ADMIN_PASSWORD.
# There is no public registration route.
# TRUST_PROXY is not read by the API yet. Leave it unset.
