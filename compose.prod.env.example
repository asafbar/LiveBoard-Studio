# Localhost-only HTTP profile for compose.prod.yaml.
# compose.prod.yaml publishes web on 127.0.0.1 and leaves API and PostgreSQL unpublished.
# Copy this file to an untracked env file and replace the database password placeholder
# with the password of the existing cluster. Do not commit that copy.
# Changing POSTGRES_DB, POSTGRES_USER, or POSTGRES_PASSWORD does not rewrite an
# initialized PostgreSQL 18 data directory. Use the existing cluster values.

WEB_PORT=8080

# Exact browser origin. 127.0.0.1 matches the published bind.
# Opening localhost can fail the bind or the CSRF origin check.
CLIENT_URL=http://127.0.0.1:8080

# false is valid only while web is bound to 127.0.0.1 and the browser uses HTTP.
# For a future HTTPS deployment, set COOKIE_SECURE=true and set CLIENT_URL to the
# exact https origin. Do not commit that origin. Do not hardcode a public domain.
COOKIE_SECURE=false

POSTGRES_DB=liveboard_studio
POSTGRES_USER=liveboard
POSTGRES_PASSWORD=replace_with_existing_database_password

# The compose file sets these inside the API container:
# DB_HOST=db
# DB_PORT=5432
# MEDIA_DIR=/app/storage/media
# PORT=4002
# NODE_ENV=production
# VITE_API_BASE_URL is empty at image build, so the browser uses same-origin /api and /socket.io.

# Do not set ADMIN_USERNAME or ADMIN_PASSWORD. This stack does not bootstrap an account.
# TRUST_PROXY is not read by the API yet. Leave it unset. See the Phase 2B review.
