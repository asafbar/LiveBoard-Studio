PORT=4002
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Local API process. A future containerized API should use DB_HOST=db and DB_PORT=5432.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=liveboard_studio
DB_USER=liveboard
DB_PASSWORD=replace_with_database_password

# Uploaded media files. Leave empty to use server/storage/media.
# This directory must stay outside client/public and must not be committed.
# A future API container should set MEDIA_DIR=/app/storage/media and mount
# the named volume liveboard_studio_media there. Do not change compose.yaml yet.
MEDIA_DIR=
